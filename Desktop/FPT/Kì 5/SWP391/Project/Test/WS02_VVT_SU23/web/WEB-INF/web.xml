<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">
    <servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>controller.login</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>search</servlet-name>
        <servlet-class>controller.search</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>delete</servlet-name>
        <servlet-class>controller.delete</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>update</servlet-name>
        <servlet-class>controller.update</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>mainController</servlet-name>
        <servlet-class>controller.mainController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>shoppingAddCart</servlet-name>
        <servlet-class>controller.shoppingAddCart</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>shoppingViewCart</servlet-name>
        <servlet-class>controller.shoppingViewCart</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>shoppingRemoveCart</servlet-name>
        <servlet-class>controller.shoppingRemoveCart</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>search</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>delete</servlet-name>
        <url-pattern>/delete</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>update</servlet-name>
        <url-pattern>/update</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>mainController</servlet-name>
        <url-pattern>/mainController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>shoppingAddCart</servlet-name>
        <url-pattern>/shoppingAddCart</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>shoppingViewCart</servlet-name>
        <url-pattern>/shoppingViewCart</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>shoppingRemoveCart</servlet-name>
        <url-pattern>/shoppingRemoveCart</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>mainController</welcome-file>
    </welcome-file-list>
</web-app>
