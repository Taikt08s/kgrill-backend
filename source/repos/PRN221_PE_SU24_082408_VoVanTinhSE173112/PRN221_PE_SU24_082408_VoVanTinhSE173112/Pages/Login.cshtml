@page
@model PRN221_PE_SU24_082408_VoVanTinhSE173112.Pages.LoginModel
@{
    ViewData["Title"] = "Login page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
<div class="container d-flex align-content-center">
    <div class="col-md-6">
        <h2>Euro2024</h2>
        <form method="post">
            <div class="mb-3">
                <label for="txtEmail" class="form-lable"> Email:</label>
                <input asp-for="account.Email" id="txtEmail" class="form-control" required />
                <span asp-validation-for="account.Email"></span>
            </div>
            <div class="mb-3">
                <label for="txtPassword" class="form-lable"> Password:</label>
                <input asp-for="account.Password" id="txtPassword" type="password" class="form-control" required />
                <span asp-validation-for="account.Password"></span>
            </div>
            <div class="text-center">
                <button type="submit">Login</button>
            </div>
            <h3 align="center" style="color:red"> @Html.ValidationMessage("Error")</h3>
        </form>
    </div>

</div>
