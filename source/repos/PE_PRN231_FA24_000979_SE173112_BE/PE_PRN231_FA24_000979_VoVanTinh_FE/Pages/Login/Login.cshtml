@page
@model PE_PRN231_FA24_000979_VoVanTinh_FE.Pages.Login.LoginModel

@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<h4>SystemAccount</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

             @if (!string.IsNullOrEmpty(Request.Query["errorMessage"]))
            {
                <h3 align="center" style="color:red">@Request.Query["errorMessage"]</h3>
            }

            <div class="form-group">
                <label asp-for="SystemAccount.EmailAddress" class="control-label"></label>
                <input asp-for="SystemAccount.EmailAddress" class="form-control" />
                <span asp-validation-for="SystemAccount.EmailAddress" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SystemAccount.AccountPassword" class="control-label"></label>
                <input type="password" asp-for="SystemAccount.AccountPassword" class="form-control" />
                <span asp-validation-for="SystemAccount.AccountPassword" class="text-danger"></span>
            </div>
           
            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
